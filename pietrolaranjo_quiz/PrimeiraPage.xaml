<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pietrolaranjo_quiz.PrimeiraPage"
             Title="PrimeiraPage">
    <ScrollView>
    <VerticalStackLayout
        Padding="30,0"
        Spacing="25">
            
        <Label 
                Text="Qual era a principal base da economia e da geração de riqueza no Império Romano?"
                FontSize="25"
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                HorizontalTextAlignment="Center"/>

       <Image
             Source="pergunta1.png"
             MaximumHeightRequest="250"/>
        
        <VerticalStackLayout Spacing="10" Padding="20">


                <RadioButton x:Name="radioButtonA"  Content="A agricultura, combinada com a exploração do trabalho escravo e a posse de terras" Value="Certo" IsChecked="True"/>
                <RadioButton x:Name="radioButtonB"  Content="O comércio de títulos de dívida pública e ações" Value="Errado"/>
                <RadioButton x:Name="radioButtonC"  Content="O monopólio estatal da indústria têxtil mecanizada" Value="Errado"/>
                <RadioButton x:Name="radioButtonD"  Content="A arrecadação de royalties sobre o licenciamento do direito de cidadania" Value="Errado"/>
            
        </VerticalStackLayout>

            <Button
                Text="Enviar"
                Clicked="OnEnviarClicked"
                HorizontalOptions="Fill"
                />


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>