<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pietrolaranjo_quiz.SetimaPage"
             Title="7)">
    <ScrollView>
        <VerticalStackLayout
Padding="30,0"
Spacing="25">

            <Label 
        Text="O que foi a Revolução Industrial?"
        FontSize="25"
        VerticalOptions="Center" 
        HorizontalOptions="Center" 
        HorizontalTextAlignment="Center"/>

            <Image
     Source="pergunta7.jpg"
     MaximumHeightRequest="250"/>

            <VerticalStackLayout Spacing="10" Padding="20">


                <RadioButton x:Name="radioButtonA"  Content="A substituição das máquinas pelo trabalho manual." Value="Errado" IsChecked="True"/>
                <RadioButton x:Name="radioButtonB"  Content="A mudança da produção manual para a produção com máquinas." Value="Certo"/>
                <RadioButton x:Name="radioButtonC"  Content="Uma revolução exclusivamente política. " Value="Errado"/>
                <RadioButton x:Name="radioButtonD"  Content="O fim das fábricas." Value="Errado"/>
            </VerticalStackLayout>

            <Button
        Text="Enviar"
        Clicked="OnEnviarClicked"
        HorizontalOptions="Fill"
        />


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>